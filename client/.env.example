# Client-side (compiled into the browser bundle — never put secrets here)
GENERATE_SOURCEMAP=false
REACT_APP_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...
REACT_APP_HBX_MINT_ADDRESS=

# Server-side, used by api/airdrop.js. Set these in the Vercel dashboard.
# Do NOT prefix them with REACT_APP_ or they will be published in the bundle.
RESEND_API_KEY=
AIRDROP_NOTIFY_TO=
AIRDROP_NOTIFY_FROM=Habix Airdrop <airdrop@habixgroup.top>
